generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model conversations {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id        String    @unique @db.Uuid
  last_message_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  matches         matches   @relation(fields: [match_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([last_message_at(sort: Desc)], map: "conversations_last_message_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model matches {
  id                            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1_id                      String         @db.Uuid
  user2_id                      String         @db.Uuid
  status                        match_status   @default(active)
  matched_at                    DateTime       @default(now()) @db.Timestamptz(6)
  unmatched_at                  DateTime?      @db.Timestamptz(6)
  conversations                 conversations?
  users_matches_user1_idTousers users          @relation("matches_user1_idTousers", fields: [user1_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_matches_user2_idTousers users          @relation("matches_user2_idTousers", fields: [user2_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user1_id, user2_id], map: "matches_pair_uq")
  @@index([status])
  @@index([user2_id], map: "matches_user2_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model photos {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String   @db.Uuid
  url                  String
  cloudinary_public_id String?
  position             Int      @default(0) @db.SmallInt
  is_primary           Boolean  @default(false)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  users                users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id], map: "photos_one_primary_per_user", where: raw("is_primary"))
  @@unique([user_id, position], map: "photos_user_position_uq")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model preferences {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String          @unique @db.Uuid
  interested_in        interested_type @default(everyone)
  age_min              Int             @default(18) @db.SmallInt
  age_max              Int             @default(99) @db.SmallInt
  max_distance_km      Int             @default(50)
  show_me              Boolean         @default(true)
  updated_at           DateTime        @default(now()) @db.Timestamptz(6)
  interested_languages String[]        @db.VarChar(50)
  users                users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model profiles {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String      @unique @db.Uuid
  display_name           String      @db.VarChar(50)
  birth_date             DateTime    @db.Date
  gender                 gender_type
  bio                    String?
  job_title              String?     @db.VarChar(100)
  pet                    String?     @db.VarChar(50)
  life_style             String[]    @db.VarChar(50)
  hobbies                Json        @default("[]")
  education              String?     @db.VarChar(100)
  height_cm              Int?        @db.SmallInt
  city                   String?     @db.VarChar(100)
  ward                   String?     @db.VarChar(100)
  latitude               Decimal?    @db.Decimal(9, 6)
  longitude              Decimal?    @db.Decimal(9, 6)
  is_verified            Boolean     @default(false)
  relationship_intention String?     @db.VarChar(50)
  languages              String[]    @db.VarChar(50)
  users                  users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([birth_date], map: "profiles_birth_idx")
  @@index([gender])
  @@index([latitude, longitude], map: "profiles_geo_idx")
  @@index([relationship_intention], map: "profiles_relationship_intention_idx")
}

model discovery_groups {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                    String                       @unique(map: "discovery_groups_slug_uq") @db.VarChar(80)
  name                    String                       @db.VarChar(100)
  is_active               Boolean                      @default(true)
  created_at              DateTime                     @default(now()) @db.Timestamptz(6)
  members                 discovery_group_members[]
  hobbies                 discovery_group_hobbies[]
  intentions              discovery_group_intentions[]
  recommendation_sessions recommendation_sessions[]

  @@index([is_active, name], map: "discovery_groups_active_name_idx")
}

model discovery_group_members {
  group_id  String           @db.Uuid
  user_id   String           @db.Uuid
  joined_at DateTime         @default(now()) @db.Timestamptz(6)
  group     discovery_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
  @@index([user_id], map: "discovery_group_members_user_idx")
}

model discovery_group_hobbies {
  group_id String           @db.Uuid
  hobby_id String           @db.VarChar(100)
  group    discovery_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, hobby_id])
  @@index([hobby_id], map: "discovery_group_hobbies_hobby_idx")
}

model discovery_group_intentions {
  group_id               String           @db.Uuid
  relationship_intention String           @db.VarChar(50)
  group                  discovery_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, relationship_intention])
  @@index([relationship_intention], map: "discovery_group_intentions_value_idx")
}

model recommendation_sessions {
  id                            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                       String                         @db.Uuid
  ranking_version               String                         @db.VarChar(32)
  created_at                    DateTime                       @default(now()) @db.Timestamptz(6)
  expires_at                    DateTime                       @db.Timestamptz(6)
  discovery_group_id            String?                        @db.Uuid
  relationship_intention_filter String?                        @db.VarChar(50)
  users                         users                          @relation("recommendation_session_owner", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  discovery_group               discovery_groups?              @relation(fields: [discovery_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items                         recommendation_session_items[]

  @@index([user_id, expires_at], map: "recommendation_sessions_user_expiry_idx")
  @@index([expires_at], map: "recommendation_sessions_expiry_idx")
  @@index([discovery_group_id], map: "recommendation_sessions_group_idx")
}

model recommendation_session_items {
  session_id        String                      @db.Uuid
  position          Int
  candidate_user_id String                      @db.Uuid
  ranking_score     Float                       @db.DoublePrecision
  missing_features  Json                        @default("[]")
  session           recommendation_sessions     @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  candidate         users                       @relation("recommendation_candidate_user", fields: [candidate_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  impression        recommendation_impressions?

  @@id([session_id, position])
  @@unique([session_id, candidate_user_id], map: "recommendation_session_candidate_uq")
  @@index([candidate_user_id], map: "recommendation_session_candidate_idx")
}

model recommendation_impressions {
  session_id        String                       @db.Uuid
  candidate_user_id String                       @db.Uuid
  position          Int
  viewed_at         DateTime                     @default(now()) @db.Timestamptz(6)
  session_item      recommendation_session_items @relation(fields: [session_id, candidate_user_id], references: [session_id, candidate_user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([session_id, candidate_user_id])
  @@index([viewed_at], map: "recommendation_impressions_viewed_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model swipes {
  id                            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  swiper_id                     String       @db.Uuid
  swiped_id                     String       @db.Uuid
  action                        swipe_action
  created_at                    DateTime     @default(now()) @db.Timestamptz(6)
  users_swipes_swiped_idTousers users        @relation("swipes_swiped_idTousers", fields: [swiped_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_swipes_swiper_idTousers users        @relation("swipes_swiper_idTousers", fields: [swiper_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([swiper_id, swiped_id], map: "swipes_pair_uq")
  @@index([swiped_id, action], map: "swipes_swiped_action_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                              String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                           String?                        @db.VarChar(255)
  google_sub                      String?                        @unique(map: "users_google_sub_uq") @db.VarChar(255)
  firebase_uid                    String?                        @unique(map: "users_firebase_uid_uq") @db.VarChar(255)
  phone                           String?                        @unique(map: "users_phone_uq") @db.VarChar(20)
  password_hash                   String?
  status                          user_status                    @default(active)
  last_active_at                  DateTime?                      @db.Timestamptz(6)
  created_at                      DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                       @default(now()) @db.Timestamptz(6)
  matches_matches_user1_idTousers matches[]                      @relation("matches_user1_idTousers")
  matches_matches_user2_idTousers matches[]                      @relation("matches_user2_idTousers")
  photos                          photos[]
  preferences                     preferences?
  profiles                        profiles?
  recommendation_sessions         recommendation_sessions[]      @relation("recommendation_session_owner")
  recommendation_candidates       recommendation_session_items[] @relation("recommendation_candidate_user")
  discovery_group_members         discovery_group_members[]
  swipes_swipes_swiped_idTousers  swipes[]                       @relation("swipes_swiped_idTousers")
  swipes_swipes_swiper_idTousers  swipes[]                       @relation("swipes_swiper_idTousers")

  @@index([last_active_at(sort: Desc)], map: "users_last_active_idx")
  @@index([status])
}

enum gender_type {
  male
  female
  non_binary
  other
}

enum interested_type {
  male
  female
  everyone
}

enum match_status {
  active
  unmatched
}

enum swipe_action {
  like
  pass
  super_like
}

enum user_status {
  active
  suspended
  deleted
}
