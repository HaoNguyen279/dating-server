# Docker Compose PostgreSQL settings
POSTGRES_DB=dating
POSTGRES_USER=dating
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432
API_PORT=3000
REDIS_PORT=6379

# The Docker Compose services set DATABASE_URL and REDIS_URL internally.
# For running the API directly on your host, use localhost instead:
DATABASE_URL=postgresql://dating:change_this_local_password@localhost:5432/dating?schema=public
DIRECT_URL=postgresql://dating:change_this_local_password@localhost:5432/dating?schema=public

# Server-side Cloudinary credentials. Keep the API secret out of the mobile app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth 2.0 Web client ID used by Google Sign-In clients.
GOOGLE_CLIENT_ID=

# Firebase Admin credentials (optional; required for Firebase auth verification).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
